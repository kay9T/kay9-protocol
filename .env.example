# KAY9 contracts environment. Never put a private key here; use --ledger or the Safe UI.

# --- networks ---
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Pin a block so the fork suite is cached and the public RPC does not rate limit you.
ROBINHOOD_FORK_BLOCK=

# --- project addresses, none of which may equal the deployer ---
OWNER_SAFE=
TREASURY=
TEAM_BENEFICIARY=
CREATOR_FEE_RECIPIENT=

# --- vesting, produced by script/ComputeVesting.s.sol ---
TGE_TIMESTAMP=
UNLOCK_6M_TIMESTAMP=
UNLOCK_12M_TIMESTAMP=

# --- audit protocol ---
AUDITORS=
AUDITOR_THRESHOLD=2
# Optional override; defaults to the address book entry for the chain.
ETH_USD_FEED=

# --- deployment safety ---
# Required, and must be exactly this string, to run against Robinhood Chain mainnet.
# Transactions are sent only when forge is invoked with --broadcast; a bare run simulates.
MAINNET_CONFIRM=

# --- launch ---
GENESIS=
FLOOR_FDV_USD=1000
GRADUATION_FDV_USD=10000
DURATION_HOURS=4
START_DELAY_MINUTES=30
LAUNCH_SALT=1

# --- verification ---
BLOCKSCOUT_API_KEY=
